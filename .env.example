# Copy to .env and fill in your own values:
#   copy .env.example .env

# LLM (chat)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_ID=your-model-id

# Embedding
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_BATCH_SIZE=10

# Optional: Markitdown OCR (falls back to LLM_* above)
OPENAI_API_KEY=
OPENAI_BASE_URL=
MARKITDOWN_OCR_MODEL=

# Optional: Bocha web search MCP
BOCHA_API_KEY=

# Optional: Tavily web search MCP (remote URL for mcp-remote)
TAVILY_API_KEY=your-tavily-api-key
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=<your-api-key>

# Optional: Qdrant (when using docker-compose)
# QDRANT__SERVICE__API_KEY=your-qdrant-secret

# Optional: Reranker (DashScope qwen3-rerank or local cross-encoder)
# RERANK_BACKEND=auto
# RERANK_MODEL_ID=qwen3-rerank
# RERANK_API_KEY=
# qwen3-rerank base (OpenAI-compatible):
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# gte-rerank-v2 / qwen3-vl-rerank base (legacy DashScope):
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# RERANK_MAX_CONCURRENCY=2
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# CROSS_ENCODER_BATCH_SIZE=32
